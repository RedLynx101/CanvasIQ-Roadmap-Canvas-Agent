# The complete manual workspace works without any environment configuration.
# Copy to .env.local only if enabling the optional AI assistant.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Operator-defined access code, at least 24 characters. Never use NEXT_PUBLIC_*.
AI_ACCESS_TOKEN=
# One persistent, writable directory for a single-instance deployment.
AI_STATE_DIR=./work/ai-state
AI_DAILY_REQUEST_LIMIT=20

